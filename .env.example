# Database config (read by compose)
POSTGRES_USER="root"
POSTGRES_PASSWORD="mysecretpassword"
POSTGRES_DB="local"

# Web app config
ORIGIN="http://localhost:5173"
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"

# Auth
# Generate with: openssl rand -base64 33
AUTH_SECRET=""

# GitHub OAuth
# Register in GitHub dev settings, callback: http://localhost:5173/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
